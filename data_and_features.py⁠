import yfinance as yf
import pandas as pd
import numpy as np
from typing import Optional

class DataAndFeatureEngine:
    def __init__(self, ticker: str, start_date: str = "2018-01-01", end_date: Optional[str] = None):
        self.ticker = ticker
        self.start_date = start_date
        self.end_date = end_date

    def fetch_ohlcv(self) -> pd.DataFrame:
        df = yf.download(self.ticker, start=self.start_date, end=self.end_date, progress=False, auto_adjust=True)
        if isinstance(df.columns, pd.MultiIndex):
            df.columns = df.columns.get_level_values(0)
        df = df[['Open', 'High', 'Low', 'Close', 'Volume']].dropna()
        return df

    def compute_features(self, df: pd.DataFrame) -> pd.DataFrame:
        data = df.copy()
        close = data['Close']
        high = data['High']
        low = data['Low']
        vol = data['Volume']

        for w in [5, 20, 60]:
            data[f'MA_{w}'] = close.rolling(w).mean()
            data[f'MA_{w}_Bias'] = (close - data[f'MA_{w}']) / data[f'MA_{w}']

        data['MA_5_20_Diff'] = (data['MA_5'] - data['MA_20']) / data['MA_20']
        data['MA_20_60_Diff'] = (data['MA_20'] - data['MA_60']) / data['MA_60']

        delta = close.diff()
        gain = delta.clip(lower=0).rolling(14).mean()
        loss = (-delta.clip(upper=0)).rolling(14).mean()
        rs = gain / loss.replace(0, np.nan)
        data['RSI_14'] = 100 - (100 / (1 + rs))

        ema12 = close.ewm(span=12, adjust=False).mean()
        ema26 = close.ewm(span=26, adjust=False).mean()
        macd_line = ema12 - ema26
        signal_line = macd_line.ewm(span=9, adjust=False).mean()
        data['MACD_Norm'] = macd_line / close
        data['MACD_Hist_Norm'] = (macd_line - signal_line) / close

        tr1 = high - low
        tr2 = (high - close.shift(1)).abs()
        tr3 = (low - close.shift(1)).abs()
        tr = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1)
        data['ATR_14'] = tr.rolling(14).mean()
        data['ATR_Pct'] = data['ATR_14'] / close

        data['Vol_Change_1D'] = vol.pct_change()
        data['Vol_Ratio_20D'] = vol / vol.rolling(20).mean()

        return data

    def create_triple_barrier_labels(
        self, df: pd.DataFrame, horizon_days: int = 10, take_profit_pct: float = 0.06, stop_loss_pct: float = 0.03
    ) -> pd.DataFrame:
        data = df.copy()
        closes = data['Close'].values
        highs = data['High'].values
        lows = data['Low'].values
        n = len(data)
        labels = np.full(n, np.nan)

        for i in range(n - horizon_days):
            entry_price = closes[i]
            tp_price = entry_price * (1.0 + take_profit_pct)
            sl_price = entry_price * (1.0 - stop_loss_pct)

            future_highs = highs[i + 1 : i + 1 + horizon_days]
            future_lows = lows[i + 1 : i + 1 + horizon_days]

            hit_tp_days = np.where(future_highs >= tp_price)[0]
            hit_sl_days = np.where(future_lows <= sl_price)[0]

            first_tp = hit_tp_days[0] if len(hit_tp_days) > 0 else np.inf
            first_sl = hit_sl_days[0] if len(hit_sl_days) > 0 else np.inf

            if first_tp < np.inf and first_tp < first_sl:
                labels[i] = 1.0
            else:
                labels[i] = 0.0

        data['Target'] = labels
        return data
