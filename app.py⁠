@st.cache_data(ttl=3600, show_spinner=False)
def run_full_pipeline(ticker, start_dt, horizon, tp, sl, prob_th, fee, tax, benchmark):
    engine = DataAndFeatureEngine(ticker=ticker, start_date=start_dt)
    raw_df = engine.fetch_ohlcv()
    if raw_df.empty:
        raise ValueError(f"無法抓取 {ticker}，台股上市請加 .TW，上櫃請加 .TWO")

    feat_df = engine.compute_features(raw_df)
    labeled_df = engine.create_triple_barrier_labels(feat_df, horizon, tp, sl)

    trainer = TimeSeriesModelAndBacktester(horizon, prob_th, fee, tax)
    pred_df, latest_prob = trainer.train_and_predict_time_series(labeled_df)
    bt_result = trainer.run_backtest(pred_df, benchmark_ticker=benchmark)

    bt_df = bt_result['backtest_df']
    bt_df['Rolling_20D_High'] = bt_df['High'].rolling(20).max()
    bt_df['Trailing_Stop_Line'] = bt_df['Rolling_20D_High'] - 2.5 * bt_df['ATR_14']

    return bt_df, latest_prob, bt_result['strategy_metrics'], bt_result['benchmark_metrics']

@st.cache_data(ttl=3600, show_spinner=False)
def run_portfolio_screener(tickers_tuple, capital, min_prob, horizon, tp, sl):
    advisor = HoldingAndPortfolioAdvisor(horizon_days=horizon, tp_pct=tp, sl_pct=sl)
    return advisor.screen_and_allocate_portfolio(list(tickers_tuple), total_capital=capital, min_prob=min_prob)

